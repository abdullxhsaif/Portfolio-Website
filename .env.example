# ──────────────────────────────────────────────
# SAIF ECOSYSTEM — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env — only .env.example is safe to push.
#
# In Vite, all client-side vars MUST be prefixed with VITE_
# Access them in code as: import.meta.env.VITE_VAR_NAME
# ──────────────────────────────────────────────

# ── Site ──────────────────────────────────────
VITE_SITE_URL=https://saif-ecosystem.vercel.app

# ── Action Links ──────────────────────────────
VITE_PATREON_URL=https://www.patreon.com/cw/saifcommunity
VITE_WHOP_URL=https://whop.com/joined/saif-library-a7cd

# ── Social Links ──────────────────────────────
VITE_GITHUB_URL=https://github.com/sponsors/abdullxhsaif
VITE_TWITTER_URL=https://x.com/abdullxhsaif
VITE_LINKEDIN_URL=https://linkedin.com/in/abdullxhsaif
VITE_YOUTUBE_URL=https://youtube.com/@abdullxhsaif
VITE_INSTAGRAM_URL=https://instagram.com/abdullxhsaif

# ── Newsletter ────────────────────────────────
# Set to your Beehiiv / ConvertKit / Mailchimp signup URL
# e.g. https://app.beehiiv.com/subscribe/your-id
VITE_NEWSLETTER_URL=

# ── AI / API Keys (server-side only — keep secret) ──
# These should NOT have the VITE_ prefix if used server-side only.
# For client-side AI calls add VITE_ prefix but be aware they are public.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Analytics ─────────────────────────────────
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
